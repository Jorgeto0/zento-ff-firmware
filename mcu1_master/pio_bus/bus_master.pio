;==============================================================================
; mcu1_master/pio_bus/bus_master.pio — PIO Bus Master (V1 board)
; Half-duplex, 1-bit serial. Master drives PIO_CLK in BOTH directions.
;
;   PIO1 (GPIO1) — data, master -> slave
;   PIO2 (GPIO2) — data, slave -> master
;   PIO_CLK (GPIO5) — clock, always master-driven
;   PIO3/PIO4 (GPIO3/4) — reserved, unused
;
; Only one state machine runs at a time, so both may sideset GPIO5 safely.
;==============================================================================

;------------------------------------------------------------------------------
; TX — master sends. Data valid while CLK low, slave samples on CLK high.
;   OUT base = PIO1, SIDESET = PIO_CLK
;------------------------------------------------------------------------------
.program bus_master_tx
.side_set 1

.wrap_target
    pull block          side 0  ; next byte, CLK low
    set x, 7            side 0  ; 8 bits
bitloop:
    out pins, 1         side 0  ; drive bit, CLK still low
    nop                 side 1  ; CLK high — slave samples here
    jmp x-- bitloop     side 0  ; CLK low again
.wrap

;------------------------------------------------------------------------------
; RX — master receives. Slave drives its bit while CLK low; master samples
; on CLK high. Master still owns the clock.
;   IN base = PIO2, SIDESET = PIO_CLK
;------------------------------------------------------------------------------
.program bus_master_rx
.side_set 1

.wrap_target
    set x, 7            side 0  ; 8 bits
bitloop:
    nop                 side 0  ; CLK low — slave presents its bit
    in pins, 1          side 1  ; CLK high — sample it
    jmp x-- bitloop     side 0  ; CLK low again
    push noblock        side 0  ; byte complete
.wrap
