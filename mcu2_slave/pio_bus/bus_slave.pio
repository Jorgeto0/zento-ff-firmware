;==============================================================================
; mcu2_slave/pio_bus/bus_slave.pio — PIO Bus Slave (V1 board)
; Half-duplex, 1-bit serial. Master owns PIO_CLK — slave NEVER drives it.
;
;   PIO1 (GPIO1) — data, master -> slave  (input here)
;   PIO2 (GPIO2) — data, slave -> master  (output here)
;   PIO_CLK (GPIO5) — clock, input only on this side
;
; Both programs use IN base = PIO1 (GPIO1), so 'wait pin 4' resolves to
; GPIO1 + 4 = GPIO5 = PIO_CLK. GPIO1-5 are contiguous, which is what makes
; this work — do not reassign these pins without redoing the offsets.
;==============================================================================

;------------------------------------------------------------------------------
; RX — slave receives. Waits for master's clock, samples PIO1 on the high.
;   IN base = PIO1
;------------------------------------------------------------------------------
.program bus_slave_rx

.wrap_target
    set x, 7                    ; 8 bits
bitloop:
    wait 1 pin 4                ; CLK high (GPIO1 + 4 = GPIO5)
    in pins, 1                  ; sample PIO1
    wait 0 pin 4                ; CLK low again
    jmp x-- bitloop
    push noblock                ; byte complete
.wrap

;------------------------------------------------------------------------------
; TX — slave sends. Presents a bit while CLK is low; master samples on high.
; No sideset — the slave does not touch the clock line.
;   OUT base = PIO2, IN base = PIO1 (for the wait offset)
;------------------------------------------------------------------------------
.program bus_slave_tx

.wrap_target
    pull block                  ; next byte from FIFO
    set x, 7                    ; 8 bits
bitloop:
    wait 0 pin 4                ; CLK low — safe to change the line
    out pins, 1                 ; present bit on PIO2
    wait 1 pin 4                ; CLK high — master samples
    jmp x-- bitloop
.wrap
